generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  COUNTER_PROPOSED
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED

  @@map("appointment_status")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("proposal_status")
}

enum EventModality {
  presencial
  virtual

  @@map("event_modality")
}

enum EventOrigin {
  admin
  comunidad

  @@map("event_origin")
}

enum EventStatus {
  borrador
  en_votacion
  publicado
  vencida
  cancelado

  @@map("event_status")
}

enum RegistrationStatus {
  confirmada
  cancelada

  @@map("registration_status")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String   @map("last_name") @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  isActive      Boolean  @default(true) @map("is_active")
  photoUrl      String?  @map("photo_url")
  city          String?
  phone         String?
  personalEmail String?  @map("personal_email")
  headline      String?
  aboutMe       String?  @map("about_me")
  cvPdfUrl      String?  @map("cv_pdf_url")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles           UserRole[]
  educations      Education[]
  workExperiences WorkExperience[]
  userSkills      UserSkill[]
  certifications  Certification[]

  mentorTechnicalAreas   MentorTechnicalArea[]
  mentorOrientationTypes MentorOrientationType[]
  availabilityBlocks     AvailabilityBlock[]
  blockedDates           BlockedDate[]

  mentorAppointments    Appointment[]        @relation("AppointmentMentor")
  studentAppointments   Appointment[]        @relation("AppointmentStudent")
  cancelledAppointments Appointment[]        @relation("AppointmentCancelledBy")
  appointmentChanges    AppointmentHistory[]

  createdEvents        Event[]             @relation("EventCreatedBy")
  moderatedEvents      Event[]             @relation("EventModeratedBy")
  eventRegistrations   EventRegistration[]
  checkedInAttendances EventAttendance[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(50)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  startAt   DateTime  @default(now()) @map("start_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId, startAt])
  @@index([roleId])
  @@map("user_roles")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  institution String
  degree      String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("educations")
}

model WorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  company     String
  position    String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("work_experiences")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isCustom  Boolean  @default(false) @map("is_custom")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model Certification {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  issuingOrganization String   @map("issuing_organization")
  issueDate           DateTime @map("issue_date") @db.Date
  documentUrl         String?  @map("document_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model TechnicalArea {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(80)
  description String?

  mentors MentorTechnicalArea[]

  @@map("technical_areas")
}

model OrientationType {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(60)
  description String?
  isActive    Boolean @default(true) @map("is_active")

  mentors      MentorOrientationType[]
  appointments Appointment[]

  @@map("orientation_types")
}

model MentorTechnicalArea {
  mentorId        String @map("mentor_id") @db.Uuid
  technicalAreaId Int    @map("technical_area_id")

  mentor        User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  technicalArea TechnicalArea @relation(fields: [technicalAreaId], references: [id], onDelete: Restrict)

  @@id([mentorId, technicalAreaId])
  @@index([technicalAreaId])
  @@map("mentor_technical_areas")
}

model MentorOrientationType {
  mentorId          String @map("mentor_id") @db.Uuid
  orientationTypeId Int    @map("orientation_type_id")

  mentor          User            @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  orientationType OrientationType @relation(fields: [orientationTypeId], references: [id], onDelete: Restrict)

  @@id([mentorId, orientationTypeId])
  @@index([orientationTypeId])
  @@map("mentor_orientation_types")
}

model AvailabilityBlock {
  id          String    @id @default(uuid()) @db.Uuid
  mentorId    String    @map("mentor_id") @db.Uuid
  startAt     DateTime  @map("start_at") @db.Timestamptz(6)
  endAt       DateTime  @map("end_at") @db.Timestamptz(6)
  seriesId    String?   @map("series_id") @db.Uuid
  repeatUntil DateTime? @map("repeat_until") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor       User           @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  proposals    TimeProposal[]

  @@index([mentorId, startAt])
  @@index([seriesId])
  @@map("availability_blocks")
}

model BlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  blockedOn DateTime @map("blocked_on") @db.Date
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([mentorId, blockedOn])
  @@map("blocked_dates")
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  blockId           String?           @map("block_id") @db.Uuid
  mentorId          String            @map("mentor_id") @db.Uuid
  studentId         String            @map("student_id") @db.Uuid
  startAt           DateTime          @map("start_at") @db.Timestamptz(6)
  endAt             DateTime          @map("end_at") @db.Timestamptz(6)
  status            AppointmentStatus @default(PENDING)
  orientationTypeId Int?              @map("orientation_type_id")
  message           String?           @db.VarChar(300)
  rejectionReason   String?           @map("rejection_reason") @db.VarChar(300)
  meetingUrl        String?           @map("meeting_url") @db.VarChar(255)
  cancelledById     String?           @map("cancelled_by") @db.Uuid
  requestedAt       DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt       DateTime?         @map("responded_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  block           AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  mentor          User               @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  student         User               @relation("AppointmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  orientationType OrientationType?   @relation(fields: [orientationTypeId], references: [id], onDelete: SetNull)
  cancelledBy     User?              @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  proposals TimeProposal[]
  history   AppointmentHistory[]

  @@index([mentorId, startAt])
  @@index([studentId, startAt])
  @@index([status])
  @@index([blockId])
  @@map("appointments")
}

model TimeProposal {
  id              String         @id @default(uuid()) @db.Uuid
  appointmentId   String         @map("appointment_id") @db.Uuid
  proposedBlockId String         @map("proposed_block_id") @db.Uuid
  message         String?        @db.VarChar(300)
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt     DateTime?      @map("responded_at") @db.Timestamptz(6)

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  proposedBlock AvailabilityBlock @relation(fields: [proposedBlockId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([proposedBlockId])
  @@map("time_proposals")
}

model AppointmentHistory {
  id             String             @id @default(uuid()) @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  previousStatus AppointmentStatus? @map("previous_status")
  newStatus      AppointmentStatus  @map("new_status")
  changedById    String?            @map("changed_by") @db.Uuid
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)
  note           String?            @db.VarChar(300)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId, changedAt])
  @@map("appointment_history")
}

model EventCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_categories")
}

model Event {
  id               String        @id @default(uuid()) @db.Uuid
  title            String        @db.VarChar(150)
  description      String?
  categoryId       Int           @map("category_id")
  instructorName   String?       @map("instructor_name") @db.VarChar(120)
  eventDate        DateTime      @map("event_date") @db.Date
  startTime        DateTime      @map("start_time") @db.Time(6)
  endTime          DateTime      @map("end_time") @db.Time(6)
  modality         EventModality
  location         String?
  capacity         Int?
  origin           EventOrigin
  status           EventStatus   @default(borrador)
  supportThreshold Int?          @map("support_threshold")
  votingDeadline   DateTime?     @map("voting_deadline") @db.Timestamptz(6)
  moderatedById    String?       @map("moderated_by") @db.Uuid
  moderationReason String?       @map("moderation_reason")
  createdById      String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  moderatedBy User?         @relation("EventModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  registrations EventRegistration[]

  @@index([categoryId])
  @@index([eventDate])
  @@index([status])
  @@map("events")
}

model EventRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  status       RegistrationStatus @default(confirmada)
  qrToken      String             @unique @map("qr_token") @db.VarChar(64)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz(6)

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance EventAttendance?

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}

model EventAttendance {
  id               String    @id @default(uuid()) @db.Uuid
  registrationId   String    @unique @map("registration_id") @db.Uuid
  checkedInAt      DateTime  @map("checked_in_at") @db.Timestamptz(6)
  checkedInById    String?   @map("checked_in_by") @db.Uuid
  checkedInOffline Boolean   @default(false) @map("checked_in_offline")
  syncedAt         DateTime? @map("synced_at") @db.Timestamptz(6)

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInBy  User?             @relation(fields: [checkedInById], references: [id], onDelete: SetNull)

  @@map("event_attendances")
}
